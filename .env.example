# API Keys for Data Sources
# Copy this file to .env and fill in your actual keys

# Finnhub (for news data)
FINNHUB_API_KEY=your_finnhub_key_here

# Trading Economics (for macro data)
TRADING_ECONOMICS_KEY=your_te_key_here

# Alpha Vantage (optional, for additional data)
ALPHA_VANTAGE_KEY=your_av_key_here

# Broker API Keys (for live trading)
ALPACA_API_KEY=your_alpaca_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets  # Paper trading

# Database (optional)
DATABASE_URL=sqlite:///trading.db

# Logging
LOG_LEVEL=INFO

# Paper Trading (recommended for testing optimizations)
PAPER_TRADING=true
